POSTGRES_HOST=127.0.0.1          # not localhost: compose binds IPv4 only, ::1 would time out first
POSTGRES_PORT=5432
POSTGRES_DB=f1
POSTGRES_USER=f1
POSTGRES_PASSWORD=change-me
OPENF1_BASE_URL=https://api.openf1.org/v1
RAW_URI=file://./data/raw          # later: gs://<bucket>/raw
SCOPE_YEARS=2023,2024,2025,2026
RATE_LIMIT_PER_SECOND=3
RATE_LIMIT_PER_MINUTE=25
HTTP_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=6
SETTLING_DAYS=3
REVIEW_SESSION_KEY=9839            # Abu Dhabi 2025 race
LOG_LEVEL=INFO

# pgAdmin (docker compose), http://localhost:8085
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=8085
