POSTGRES_HOST=127.0.0.1          # not localhost: compose binds IPv4 only, ::1 would time out first
POSTGRES_PORT=5432
POSTGRES_DB=f1
POSTGRES_USER=f1
POSTGRES_PASSWORD=change-me
RAW_URI=file://./data/raw          # later: gs://<bucket>/raw

# pgAdmin (docker compose), http://localhost:8085
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=8085
