# Copy this file to .env (`cp .env.example .env`), then:
#   1. set HOST_DATA_DIR (required, see below)
#   2. replace the example passwords (optional on a private laptop; all ports are bound
#      to 127.0.0.1, so only your own machine can reach the services)

# Absolute path of this repo's data/ folder. Kestra starts each task in its own container
# and mounts this folder into it, so Docker needs the full path on your laptop.
#   macOS/Linux:        run `echo "$PWD/data"` in the repo folder
#   Windows PowerShell: run `(Resolve-Path data).Path.Replace('\', '/')` in the repo folder
#                       (create the folder first with `mkdir data` if it does not exist)
HOST_DATA_DIR=/absolute/path/to/DENG/data

# Project database (the F1 data)
POSTGRES_DB=f1
POSTGRES_USER=f1
POSTGRES_PASSWORD=change-me-f1-database

# pgAdmin (browser UI for the database): http://localhost:8085
PGADMIN_DEFAULT_EMAIL=student@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_PORT=8085

# Kestra (orchestrator UI): http://localhost:8080
# The user must be an email address; the password needs 8+ characters, an upper-case
# letter, a lower-case letter and a digit.
KESTRA_PORT=8080
KESTRA_USER=student@example.com
KESTRA_PASSWORD=Change-me-Kestra1
KESTRA_DB_PASSWORD=change-me-kestra-database
